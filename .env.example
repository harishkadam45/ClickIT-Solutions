# Canonical origin. Include the scheme — a bare host is normalised to https://,
# but an unparseable value falls back to the default below rather than failing
# the build. Keep this in sync with the production domain you actually serve.
PUBLIC_SITE_URL=https://www.clickitsolution.co.tz

# Contact details. Leave blank to use the demo placeholders in src/data/site.ts.
PUBLIC_PHONE_DISPLAY=+255 754 000 000
PUBLIC_PHONE_E164=+255754000000
PUBLIC_WHATSAPP_NUMBER=255754000000
PUBLIC_WA_MESSAGE=Hello%20ClickIT%20Solutions%2C%20I%27d%20like%20to%20discuss%20a%20project.

# Analytics. All optional — tags are omitted entirely when blank.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_ID=
PUBLIC_GADS_ID=
PUBLIC_GTM_DATA_LAYER_NAME=dataLayer

# Lead form destination (Formspree, Basin, your own API route...). Blank = demo
# mode: the form validates and confirms client-side, nothing is transmitted.
PUBLIC_FORM_ENDPOINT=
