---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { site, waLink, TRACK } from '../data/site';

const wa = waLink(`Hi ClickIT Solutions, I could not find what I was looking for.`);
---

<BaseLayout
  title="Page not found (404)"
  description="The page you are looking for has moved or no longer exists. Browse our services or contact ClickIT Solutions in Dar es Salaam, Tanzania."
  noindex
>
  <Header />
  <main id="main" class="relative overflow-hidden bg-white py-24 text-ink-950 sm:py-32">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute top-0 left-1/3 size-[38rem] -translate-x-1/2 rounded-full bg-jade-500/8 blur-[130px]"
      >
      </div>
    </div>

    <div class="container-page relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-display text-[5rem] leading-none font-extrabold text-jade-600 sm:text-[7rem]">
          404
        </p>
        <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">This page has moved or never existed</h1>
        <p class="mt-5 text-[1.05rem] leading-relaxed text-ink-700">
          The link may be outdated, or the page may have been renamed. Here is where most people were
          heading.
        </p>

        <div
          class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
        >
          <a
            href="/"
            class="group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-ink-950 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-ink-800"
          >
            Back to homepage
            <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            data-track={TRACK.whatsapp}
            data-track-label="404"
            class="inline-flex items-center justify-center gap-2.5 rounded-2xl bg-gray-100 px-6 py-3.5 text-sm font-bold text-ink-900 transition-colors hover:bg-gray-200"
          >
            <Icon name="whatsapp" class="size-4.5 text-jade-600" /> Ask us directly
          </a>
        </div>

        <div class="mt-14 text-left">
          <p class="eyebrow text-ink-500">Popular services</p>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            {
              services.slice(0, 6).map((s) => (
                <a
                  href="/#services"
                  class="flex items-center gap-2.5 rounded-xl bg-gray-100 px-4 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-gray-200"
                >
                  <Icon name={s.icon} class="size-4 shrink-0 text-jade-600" />
                  {s.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
