---
import Icon from './Icon.astro';
import { site, telLink, waLink, TRACK } from '../data/site';
import { services } from '../data/services';

const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'Industries', href: '#industries' },
  { label: 'Case Studies', href: '#case-studies' },
  { label: 'Process', href: '#process' },
  { label: 'Insights', href: '#insights' },
  { label: 'About', href: '#why-clickit' },
];

const wa = waLink(site.contact.waMessage);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300 data-[scrolled]:border-b data-[scrolled]:border-gray-200 data-[scrolled]:bg-white/85 data-[scrolled]:backdrop-blur-xl"
>
  <div class="container-page">
    <div class="flex h-18 items-center justify-between gap-4">
      <!-- Logo -->
      <a
        href="#top"
        data-track={TRACK.nav}
        data-track-label="logo"
        class="group flex items-center gap-2.5"
        aria-label={`${site.name} home`}
      >
        <span
          class="relative grid size-9 place-items-center rounded-xl bg-ink-900 text-jade-400 shadow-[0_2px_12px_-2px_rgba(5,8,15,0.5)] transition-transform duration-300 group-hover:scale-105"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
            <path
              d="M5 4.5v15h14"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="17" cy="8" r="2.4" fill="currentColor"></circle>
          </svg>
        </span>
        <span class="leading-none">
          <span class="block font-display text-[1.05rem] font-extrabold tracking-tight text-ink-900"
            >ClickIT<span class="text-jade-700"> Solutions</span></span
          >
          <span class="mt-0.5 block text-[0.62rem] font-semibold tracking-[0.18em] text-ink-600 uppercase"
            >Tanzania</span
          >
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              data-track={TRACK.nav}
              data-track-label={l.label}
              class="group relative rounded-lg px-3 py-2 text-[0.9rem] font-medium text-ink-700 transition-colors hover:text-ink-950"
            >
              {l.label}
            </a>
          ))
        }
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1 rounded-lg px-3 py-2 text-[0.9rem] font-medium text-ink-700 transition-colors hover:text-ink-950"
            aria-expanded="false"
          >
            All services
            <Icon name="chevronDown" class="size-3.5 transition-transform duration-200 group-hover:rotate-180" />
          </button>
          <div
            class="invisible absolute top-full left-1/2 w-[30rem] -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
          >
            <div
              class="grid grid-cols-2 gap-1 rounded-2xl border border-gray-200 bg-white p-2 shadow-[0_24px_60px_-20px_rgba(5,8,15,0.18)]"
            >
              {
                services.map((s) => (
                  <a
                    href={`#services`}
                    data-track={TRACK.nav}
                    data-track-label={s.name}
                    class="flex items-start gap-2.5 rounded-xl px-3 py-2.5 transition-colors hover:bg-gray-100"
                  >
                    <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-jade-50 text-jade-700">
                      <Icon name={s.icon} class="size-4" />
                    </span>
                    <span>
                      <span class="block text-[0.82rem] font-semibold text-ink-900">{s.name}</span>
                      <span class="mt-0.5 block text-[0.72rem] leading-snug text-ink-600">
                        {s.short}
                      </span>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </nav>

      <!-- CTAs -->
      <div class="hidden items-center gap-2 md:flex">
        <a
          href={telLink}
          data-track={TRACK.phone}
          data-track-label="header"
          class="hidden items-center gap-2 rounded-xl border border-gray-200 bg-gray-100 px-3.5 py-2.5 text-[0.85rem] font-semibold text-ink-800 transition-colors hover:border-gray-300 hover:bg-gray-200 xl:flex"
        >
          <Icon name="phone" class="size-4" />
          {site.contact.phoneDisplay}
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          data-track={TRACK.whatsapp}
          data-track-label="header"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-ink-950 px-4 py-2.5 text-[0.85rem] font-semibold text-white transition-all hover:bg-ink-800"
        >
          <Icon name="whatsapp" class="size-4 text-jade-400" />
          Talk to us
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="grid size-11 place-items-center rounded-xl border border-gray-200 bg-gray-100 text-ink-900 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-5" data-menu-icon />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-x-0 top-18 max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-gray-200 bg-white opacity-0 transition-all duration-300 md:hidden"
  >
    <div class="container-page py-5">
      <nav class="flex flex-col" aria-label="Mobile">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              data-track={TRACK.nav}
              data-track-label={`mobile-${l.label}`}
              class="flex items-center justify-between border-b border-gray-200 py-3.5 font-display text-lg font-bold text-ink-900"
            >
              {l.label}
              <Icon name="arrowUpRight" class="size-4 text-ink-500" />
            </a>
          ))
        }
      </nav>
      <p class="eyebrow mt-6 text-ink-600">Services</p>
      <div class="mt-3 grid gap-1.5">
        {
          services.slice(0, 6).map((s) => (
            <a
              href="#services"
              class="flex items-center gap-2.5 rounded-xl bg-gray-100 px-3 py-2.5 text-sm font-semibold text-ink-800"
            >
              <Icon name={s.icon} class="size-4 text-jade-600" />
              {s.name}
            </a>
          ))
        }
      </div>
      <div class="mt-6 grid gap-2.5">
        <a
          href="#contact"
          data-track={TRACK.consultation}
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-ink-950 px-5 py-3.5 text-sm font-bold text-white"
        >
          Book a free consultation <Icon name="arrowRight" class="size-4" />
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          data-track={TRACK.whatsapp}
          data-track-label="mobile-menu"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-100 px-5 py-3.5 text-sm font-bold text-ink-900"
        >
          <Icon name="whatsapp" class="size-4 text-jade-600" /> WhatsApp us
        </a>
        <a
          href={telLink}
          data-track={TRACK.phone}
          data-track-label="mobile-menu"
          class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-ink-700"
        >
          <Icon name="phone" class="size-4" /> {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<div class="h-18" aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 12) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('invisible', !open);
    menu.classList.toggle('opacity-0', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setOpen(false);
  });
</script>
