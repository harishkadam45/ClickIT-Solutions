---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { caseStudies } from '../../data/content';
import { TRACK } from '../../data/site';

const accentMap = {
  jade: { glow: 'bg-jade-500/16', text: 'text-jade-400', bg: 'bg-jade-500/15' },
  azure: { glow: 'bg-azure-400/16', text: 'text-azure-400', bg: 'bg-azure-400/15' },
  signal: { glow: 'bg-signal-500/16', text: 'text-signal-400', bg: 'bg-signal-500/15' },
};
---

<section id="case-studies" class="relative bg-white py-20 sm:py-28">
  <div class="container-page">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeader
        eyebrow="Portfolio & case studies"
        title="Work we can show you, not work we can only describe."
        lead="A selection of delivered systems. Each case study follows the same structure — challenge, solution, what shipped — and new projects slot into the same template without a redesign."
      />
      <p
        class="max-w-xs shrink-0 rounded-2xl bg-gray-100 p-5 text-[0.8rem] leading-relaxed text-ink-600"
      >
        <span class="font-bold text-ink-900">Note:</span> figures on this page are only included
        where a client has verified them. We do not publish invented statistics.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        caseStudies.map((cs) => {
          const a = accentMap[cs.accent];
          return (
            <article
              class:list={[
                'group flex flex-col overflow-hidden rounded-2xl bg-gray-100 transition-all duration-400 hover:-translate-y-1.5 hover:bg-gray-200 hover:shadow-[0_30px_60px_-30px_rgba(5,8,15,0.4)]',
              ]}
            >
              <!-- Visual placeholder: real screenshots replace this -->
              <div class="relative aspect-16/10 overflow-hidden bg-ink-950">
                <div
                  class:list={[
                    'absolute inset-0 opacity-60 transition-opacity duration-500 group-hover:opacity-90',
                    a.glow,
                  ]}
                />
                <div class="absolute inset-0 flex flex-col justify-between p-6">
                  <div class="flex items-start justify-between">
                    <span
                      class:list={[
                        'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[0.68rem] font-bold backdrop-blur',
                        a.bg,
                        a.text,
                      ]}
                    >
                      <span class="size-1.5 rounded-full bg-current" />
                      {cs.status}
                    </span>
                    <span class="rounded-full bg-white/10 px-3 py-1 text-[0.68rem] font-semibold text-ink-200 backdrop-blur">
                      {cs.industry}
                    </span>
                  </div>
                  <div>
                    <h3 class="font-display text-2xl font-extrabold text-white sm:text-[1.75rem]">
                      {cs.client}
                    </h3>
                    <p class="mt-1.5 max-w-xs text-[0.82rem] leading-snug text-ink-300">
                      {cs.title}
                    </p>                  </div>
                </div>
              </div>

              <div class="flex flex-1 flex-col p-7">
                <p class="text-[0.68rem] font-bold tracking-[0.14em] text-ink-500 uppercase">
                  The challenge
                </p>
                <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-700">{cs.challenge}</p>

                <p class="mt-5 text-[0.68rem] font-bold tracking-[0.14em] text-ink-500 uppercase">
                  What we built
                </p>
                <ul class="mt-2 space-y-1.5">
                  {cs.features.map((f) => (
                    <li class="flex items-start gap-2 text-[0.85rem] text-ink-700">
                      <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-jade-600" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 flex flex-wrap gap-1.5 border-t border-gray-300/70 pt-5">
                  {cs.tech.map((t) => (
                    <span
                      class="rounded-lg bg-white px-2.5 py-1 text-[0.7rem] font-semibold text-ink-600"
                    >
                      {t}
                    </span>
                  ))}
                </div>

                <a
                  href="#contact"
                  data-track={TRACK.caseStudy}
                  data-track-label={cs.client}
                  class="mt-6 inline-flex items-center gap-1.5 text-[0.85rem] font-bold text-ink-900 transition-colors hover:text-jade-700"
                >
                  Read the full case study
                  <Icon
                    name="arrowRight"
                    class="size-3.5 transition-transform duration-300 group-hover:translate-x-1"
                  />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
