---
import Icon from '../Icon.astro';
import { caseStudies } from '../../data/content';
import { site, telLink, waLink, TRACK } from '../../data/site';

const wa = waLink(
  `Hi ClickIT Solutions, I'd like to book a consultation about a project.`
);

const assurances = [
  { icon: 'shield', t: 'NDA signed before we look', d: 'Happy to use your template.' },
  { icon: 'users', t: 'References on request', d: 'Speak to past clients directly.' },
  { icon: 'clock', t: 'Reply within one business day', d: 'Not a chatbot, a developer.' },
  { icon: 'check', t: 'Written scope before payment', d: 'Price range and phases agreed up front.' },
];
---

<!-- Proof band -->
<section id="proof" class="border-y border-gray-200 bg-white py-14">
  <div class="container-page">
    <p class="text-center text-[0.7rem] font-bold tracking-[0.18em] text-ink-500 uppercase">
      Systems we have delivered
    </p>
    <ul
      class="mt-7 flex flex-wrap items-center justify-center gap-x-10 gap-y-5 sm:gap-x-16"
    >
      {
        [...caseStudies.map((c) => c.client), 'Jipangishe', 'School systems', 'Fleet platforms']
          .slice(0, 6)
          .map((name) => (
            <li class="font-display text-lg font-extrabold tracking-tight text-ink-500 sm:text-xl">
              {name}
            </li>
          ))
      }
    </ul>
    <p class="mt-7 text-center text-xs text-ink-500">
      Some client names are published with permission. Others are available as references under NDA.
    </p>
  </div>
</section>

<!-- Final CTA -->
<section id="get-started" class="relative overflow-hidden bg-white py-20 text-ink-950 sm:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/2 left-1/2 size-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-jade-500/10 blur-[130px]"
    >
    </div>
  </div>

  <div class="container-page relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow justify-center text-jade-700">
        <span class="h-px w-6 bg-jade-600/40"></span>
        Next step
        <span class="h-px w-6 bg-jade-600/40"></span>
      </p>
      <h2 class="mt-5 text-3xl leading-[1.1] font-extrabold sm:text-5xl">
        Tell us what is not working.
        <span class="block text-ink-500">We will tell you what it takes to fix.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-[1.05rem] leading-relaxed text-ink-700">
        A 30-minute call is enough for us to understand the problem and give you an honest view of
        scope, cost and whether software is even the right fix.
      </p>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <a
          href="#contact"
          data-track={TRACK.consultation}
          data-track-label="final-cta"
          class="group inline-flex w-full items-center justify-center gap-2.5 rounded-2xl bg-ink-950 px-7 py-4 text-[0.95rem] font-bold text-white shadow-[0_10px_30px_-12px_rgba(5,8,15,0.5)] transition-colors hover:bg-ink-800 sm:w-auto"
        >
          Book a consultation
          <Icon name="arrowRight" class="size-4.5 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          data-track={TRACK.whatsapp}
          data-track-label="final-cta"
          class="inline-flex w-full items-center justify-center gap-2.5 rounded-2xl bg-gray-100 px-7 py-4 text-[0.95rem] font-bold text-ink-900 transition-colors hover:bg-gray-200 sm:w-auto"
        >
          <Icon name="whatsapp" class="size-5 text-jade-600" />
          Talk to us on WhatsApp
        </a>
      </div>

      <a
        href={telLink}
        data-track={TRACK.phone}
        data-track-label="final-cta"
        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink-700 transition-colors hover:text-ink-950"
      >
        <Icon name="phone" class="size-4 text-jade-600" />
        {site.contact.phoneDisplay}
      </a>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        assurances.map((a) => (
          <div class="rounded-2xl bg-gray-100 p-5 text-center">
            <span class="mx-auto grid size-9 place-items-center rounded-xl bg-white text-jade-600 shadow-[0_2px_10px_-4px_rgba(5,8,15,0.25)]">
              <Icon name={a.icon} class="size-4.5" />
            </span>
            <p class="mt-3.5 text-[0.85rem] font-bold text-ink-950">{a.t}</p>
            <p class="mt-1 text-[0.75rem] leading-snug text-ink-600">{a.d}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
