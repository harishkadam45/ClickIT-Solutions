---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

const pain = [
  {
    t: 'Business runs on spreadsheets',
    d: 'Critical data lives in files that only one person understands, and nobody can trace a number back to source.',
  },
  {
    t: 'Growth outpaces the process',
    d: 'The team is doing three times the work with the same manual steps, and errors compound as volume rises.',
  },
  {
    t: 'No visibility for management',
    d: 'Decisions wait on a report that arrives late, built from numbers nobody fully trusts.',
  },
  {
    t: 'Generic tools do not fit',
    d: 'Off-the-shelf software forces your operation into its shape, and the critical work still happens in WhatsApp.',
  },
];

const whatWeDo = [
  {
    icon: 'code',
    t: 'Custom software',
    d: 'Web, mobile and back-office systems engineered around your actual workflow — not a template bent to fit.',
  },
  {
    icon: 'mobile',
    t: 'Mobile apps',
    d: 'iOS and Android apps for customers, staff and field teams, designed for real network conditions.',
  },
  {
    icon: 'automation',
    t: 'Business automation',
    d: 'We map the manual steps that slow you down and automate them end to end, including the integrations.',
  },
  {
    icon: 'design',
    t: 'Product & UX design',
    d: 'Research, prototypes and design systems so your team actually adopts the software they are given.',
  },
];
---

<section id="what-we-do" class="relative bg-white py-20 sm:py-28">
  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <SectionHeader
          eyebrow="What we do"
          title="The bottleneck is rarely the software you were sold."
          lead="It is the manual work sitting between your systems and your people. That is what we remove."
        />

        <div class="mt-8 space-y-4">
          {
            pain.map((p) => (
              <div class="flex gap-3.5 border-l-2 border-ink-900/10 pl-5">
                <div>
                  <p class="font-display text-[0.98rem] font-bold text-ink-900">{p.t}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-700">{p.d}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            whatWeDo.map((w, i) => (
              <article
              class:list={[
                'card-hover group relative overflow-hidden rounded-2xl bg-gray-100 p-7 hover:bg-gray-200 hover:shadow-[0_20px_45px_-25px_rgba(5,8,15,0.35)]',
                i === 0 && 'sm:col-span-2',
              ]}
            >
              <div
                class="absolute -top-16 -right-16 size-40 rounded-full bg-jade-500/0 blur-2xl transition-all duration-500 group-hover:bg-jade-500/12"
                aria-hidden="true"
              />
              <span class="relative grid size-11 place-items-center rounded-xl bg-ink-950 text-jade-400">
                  <Icon name={w.icon} class="size-5" />
                </span>
                <h3 class="relative mt-5 font-display text-lg font-extrabold text-ink-950">
                  {w.t}
                </h3>
                <p class="relative mt-2.5 text-[0.92rem] leading-relaxed text-ink-700">{w.d}</p>
                <a
                  href="#services"
                  class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-jade-700 transition-colors hover:text-jade-600"
                >
                  Explore
                  <Icon name="arrowRight" class="size-3.5" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
