---
import Icon from '../Icon.astro';
import { site, telLink, waLink, TRACK } from '../../data/site';

const wa = waLink(site.contact.waMessage);

const proof = [
  { value: '9', label: 'Service lines' },
  { value: '2 wks', label: 'Release cycles' },
  { value: '100%', label: 'Code ownership' },
  { value: 'TZ', label: 'Based & delivering' },
];
---

<section id="hero" class="relative overflow-hidden bg-white text-ink-950">
  <!-- Background system -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-56 left-[8%] size-[42rem] rounded-full bg-jade-500/10 blur-[130px]"
    >
    </div>
    <div
      class="absolute -top-32 right-[4%] size-[34rem] rounded-full bg-azure-400/10 blur-[130px]"
    >
    </div>
  </div>

  <div class="container-page relative">
    <div class="grid items-center gap-14 pt-16 pb-20 lg:grid-cols-12 lg:gap-10 lg:pt-24 lg:pb-28">
      <div class="lg:col-span-7">
        <p
          class="inline-flex items-center gap-2.5 rounded-full border border-gray-200 bg-gray-100 py-1.5 pr-4 pl-1.5 text-xs font-medium text-ink-700"
        >
          <span class="inline-flex items-center gap-1.5 rounded-full bg-jade-500/12 px-2.5 py-1 text-[0.68rem] font-bold tracking-wide text-jade-800 uppercase">
            <span class="relative flex size-1.5">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-jade-500 opacity-75"
              ></span>
              <span class="relative inline-flex size-1.5 rounded-full bg-jade-600"></span>
            </span>
            Now taking Q4 projects
          </span>
          Custom software, Tanzania
        </p>

        <h1 class="mt-6 text-[2.6rem] leading-[1.05] font-extrabold tracking-tight sm:text-[3.5rem] lg:text-[3.75rem]">
          Build technology that{' '}
          <span class="relative inline-block bg-gradient-to-r from-jade-500 via-jade-600 to-azure-600 bg-clip-text pb-1 text-transparent">
            moves your business
            <svg
              class="absolute -bottom-0.5 left-0 h-2 w-full"
              viewBox="0 0 300 8"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M2 5.5C60 2 130 1 298 4"
                stroke="url(#hl)"
                stroke-width="3.5"
                stroke-linecap="round"></path>
              <defs>
                <linearGradient id="hl" x1="0" y1="0" x2="300" y2="0">
                  <stop stop-color="#10b884"></stop>
                  <stop offset="1" stop-color="#0ea5e9"></stop>
                </linearGradient>
              </defs>
            </svg>
          </span>{' '}
          forward.
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-700 sm:text-xl">
          Custom software, mobile apps and digital solutions built around the way your business
          works — delivered from Dar es Salaam for SMEs, corporates and institutions across
          Tanzania.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#contact"
            data-track={TRACK.consultation}
            data-track-label="hero"
            class="group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-ink-950 px-6 py-4 text-[0.95rem] font-bold text-white shadow-[0_10px_30px_-12px_rgba(5,8,15,0.5)] transition-all hover:bg-ink-800"
          >
            Book a consultation
            <Icon
              name="arrowRight"
              class="size-4.5 transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            data-track={TRACK.whatsapp}
            data-track-label="hero"
            class="group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-gray-100 px-6 py-4 text-[0.95rem] font-bold text-ink-900 transition-colors hover:bg-gray-200"
          >
            <Icon name="whatsapp" class="size-5 text-jade-600" />
            Talk to us on WhatsApp
          </a>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-sm text-ink-700">
          <span class="inline-flex items-center gap-2">
            <Icon name="check" class="size-4 text-jade-600" /> Free 30-minute discovery call
          </span>
          <a
            href={telLink}
            data-track={TRACK.phone}
            data-track-label="hero"
            class="inline-flex items-center gap-2 transition-colors hover:text-ink-950"
          >
            <Icon name="phone" class="size-4 text-jade-600" />
            or call {site.contact.phoneDisplay}
          </a>
        </div>
      </div>

      <!-- Visual / product panel -->
      <div class="lg:col-span-5">
        <div class="relative animate-float-slow">
          <div
            class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-jade-500/12 via-transparent to-azure-400/12 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative overflow-hidden rounded-3xl border border-gray-200 bg-gray-100 shadow-[0_30px_70px_-35px_rgba(5,8,15,0.35)]"
          >
            <!-- Mock product UI -->
            <div class="p-3">
              <div class="overflow-hidden rounded-2xl bg-ink-950">
                <div
                  class="flex items-center gap-2 border-b border-white/8 px-5 py-3.5"
                >
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span class="size-2.5 rounded-full bg-white/20"></span>
                  <span
                    class="ml-2 truncate rounded-md bg-white/5 px-2.5 py-1 font-mono text-[0.68rem] text-ink-300"
                  >
                    app.clickit.co.tz
                  </span>
                </div>

                <div class="space-y-4 p-5">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-[0.65rem] font-bold tracking-[0.16em] text-ink-300 uppercase">
                        Live operations
                      </p>
                      <p class="font-display text-lg font-extrabold text-white">
                        One system, every branch
                      </p>
                    </div>
                    <span
                      class="inline-flex items-center gap-1.5 rounded-full bg-jade-500/15 px-2.5 py-1 text-[0.68rem] font-bold text-jade-300"
                    >
                      <Icon name="bolt" class="size-3" /> Synced
                    </span>
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    {
                      [
                        { k: 'Sales today', v: 'TZS 48.2M', d: '+18% vs last week' },
                        { k: 'Open orders', v: '312', d: '47 awaiting dispatch' },
                      ].map((m) => (
                        <div class="rounded-2xl border border-white/8 bg-white/[0.03] p-4">
                          <p class="text-[0.7rem] font-medium text-ink-300">{m.k}</p>
                          <p class="mt-1 font-display text-xl font-extrabold text-white">{m.v}</p>
                          <p class="mt-0.5 text-[0.68rem] text-jade-400">{m.d}</p>
                        </div>
                      ))
                    }
                  </div>

                  <div class="rounded-2xl border border-white/8 bg-white/[0.03] p-4">
                    <div class="flex items-center justify-between">
                      <p class="text-[0.7rem] font-medium text-ink-300">Automation coverage</p>
                      <p class="font-mono text-[0.7rem] text-jade-400">92%</p>
                    </div>
                    <div class="mt-3 flex h-24 items-end gap-1.5">
                      {
                        [38, 52, 44, 61, 55, 72, 66, 80, 74, 88, 82, 92].map((h, i) => (
                          <span
                            class:list={[
                              'flex-1 rounded-t-sm',
                              i > 8 ? 'bg-jade-500' : 'bg-white/12',
                            ]}
                            style={`height:${h}%`}
                          />
                        ))
                      }
                    </div>
                  </div>

                  <div class="space-y-2">
                    {
                      [
                        { i: 'pos', t: 'POS checkout completed', m: 'Receipt auto-sent · 2s' },
                        { i: 'mobile', t: 'Mobile money callback received', m: 'Auto-reconciled' },
                        { i: 'logistics', t: 'Driver assigned to route', m: 'Customer notified' },
                      ].map((r) => (
                        <div class="flex items-center gap-3 rounded-xl border border-white/8 bg-white/[0.02] px-3.5 py-2.5">
                          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-jade-500/12 text-jade-400">
                            <Icon name={r.i} class="size-4" />
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="block truncate text-[0.8rem] font-semibold text-white">
                              {r.t}
                            </span>
                            <span class="block truncate text-[0.68rem] text-ink-300">{r.m}</span>
                          </span>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating chips -->
          <div
            class="absolute -top-4 -left-3 hidden items-center gap-2 rounded-2xl border border-gray-200 bg-gray-100 px-3.5 py-2.5 shadow-[0_18px_35px_-20px_rgba(5,8,15,0.4)] sm:flex"
          >
            <span class="grid size-7 place-items-center rounded-lg bg-jade-500/12 text-jade-700">
              <Icon name="shield" class="size-4" />
            </span>
            <span class="text-[0.72rem] leading-tight font-bold text-ink-900">
              You own the code
              <span class="block text-[0.65rem] font-medium text-ink-600">No lock-in</span>
            </span>
          </div>
          <div
            class="absolute -right-3 bottom-10 hidden items-center gap-2 rounded-2xl border border-gray-200 bg-gray-100 px-3.5 py-2.5 shadow-[0_18px_35px_-20px_rgba(5,8,15,0.4)] sm:flex"
          >
            <span class="grid size-7 place-items-center rounded-lg bg-signal-500/15 text-signal-500">
              <Icon name="clock" class="size-4" />
            </span>
            <span class="text-[0.72rem] leading-tight font-bold text-ink-900">
              Delivered in cycles
              <span class="block text-[0.65rem] font-medium text-ink-600">Every 2 weeks</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Proof strip -->
    <div
      class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-gray-200 bg-gray-200 sm:grid-cols-4"
    >
      {
        proof.map((p) => (
          <div class="bg-gray-100 px-5 py-6 text-center">
            <p class="font-display text-2xl font-extrabold text-ink-950 sm:text-3xl">{p.value}</p>
            <p class="mt-1 text-[0.7rem] font-semibold tracking-[0.12em] text-ink-600 uppercase">
              {p.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
